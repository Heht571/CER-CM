# 环境配置
NODE_ENV=development
PORT=3000

# PostgreSQL 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jifang_jianshe
DB_USER=root
DB_PASSWORD=root123

# JWT 配置（必填：请替换为至少 16 位的随机字符串）
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS 白名单（逗号分隔）
# 留空时：development 默认允许 localhost/127.0.0.1:8080，其他环境默认不开放浏览器跨域来源
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# API 文档（默认关闭；如需管理员访问控制，可改为 true）
SWAGGER_ENABLED=false
SWAGGER_REQUIRE_ADMIN=false
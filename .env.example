# ========================================
# 机房建设监控平台 - 环境变量配置示例
# ========================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ===========================================
# 后端配置 (Node.js + Express)
# ===========================================

# ----------------------------------------
# 基础配置
# ----------------------------------------
NODE_ENV=development
PORT=3000

# ----------------------------------------
# PostgreSQL 数据库配置
# ----------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jifang_jianshe
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ----------------------------------------
# JWT 配置（必填：请替换为至少 16 位的随机字符串）
# ----------------------------------------
# ⚠️ 重要：生产环境请使用强随机密钥，不要使用示例值
# 登录状态默认保留12小时，可根据需求调整
JWT_SECRET=replace-with-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=12h

# ----------------------------------------
# CORS 白名单（逗号分隔）
# ----------------------------------------
# 留空时：development 默认允许 localhost/127.0.0.1:8080
# 生产环境请配置实际的前端域名
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ----------------------------------------
# API 文档 (Swagger)
# ----------------------------------------
# 生产环境建议关闭或限制访问
SWAGGER_ENABLED=false
SWAGGER_REQUIRE_ADMIN=false

# ----------------------------------------
# 邮件服务配置（可选，可在前端管理界面配置）
# ----------------------------------------
# 如需启用邮件发送，请配置 SMTP 信息
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM_NAME=机房建设监控平台
EMAIL_FROM_ADDRESS=your_email@example.com

# ===========================================
# 前端配置 (Vue.js)
# ===========================================
# Vue CLI 环境变量必须以 VUE_APP_ 开头才能在代码中使用
# 注意：前端需要单独配置，参见 frontend/.env.example

# ----------------------------------------
# 应用标题
# ----------------------------------------
VUE_APP_TITLE=机房建设监控平台

# ----------------------------------------
# API 基础路径
# ----------------------------------------
# 开发环境通过 vue.config.js 的 proxy 代理到后端
# 生产环境请配置实际的后端 API 地址
VUE_APP_API_BASE_URL=/api